# Copy these into Streamlit Community Cloud > App settings > Secrets
# (for local use: save as .streamlit/secrets.toml, which is git-ignored)
GOOGLE_MAPS_API_KEY = "your-google-maps-platform-key"
GEMINI_API_KEY = "your-google-ai-studio-key"
# Optional: change the Gemini model without touching the code
# GEMINI_MODEL = "gemini-2.5-flash"
